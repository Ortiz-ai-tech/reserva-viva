---
import Base from '../layouts/Base.astro';
import CalculadoraAgua from '../components/CalculadoraAgua.jsx';

const ICONOS = {
  gota: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5c-3.2 4.2-5.5 7.6-5.5 10.5a5.5 5.5 0 0 0 11 0c0-2.9-2.3-6.3-5.5-10.5z"/></svg>`,
  matraz: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3h4"/><path d="M10.5 3v5.2L6 17a1.6 1.6 0 0 0 1.4 2.3h9.2A1.6 1.6 0 0 0 18 17l-4.5-8.8V3"/><circle cx="12" cy="15.5" r="1"/></svg>`,
  saco: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3.5h6l.8 3.2a3.8 3.8 0 0 1-7.6 0z"/><path d="M7.3 10.5c-1.4 2.7-1.8 6-.9 9a2 2 0 0 0 1.9 1.5h7.4a2 2 0 0 0 1.9-1.5c.9-3 .5-6.3-.9-9"/></svg>`,
  cambio: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 8h10"/><path d="M14 5l3 3-3 3"/><path d="M17 16H7"/><path d="M10 13l-3 3 3 3"/></svg>`,
  caja: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5 12 4l8.5 4.5-8.5 4.5-8.5-4.5z"/><path d="M3.5 8.5v7L12 20l8.5-4.5v-7"/><path d="M12 13v7"/></svg>`,
  brote: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V11"/><path d="M12 11c0-3.5-2.5-6-6-6 0 3.5 2.5 6 6 6z"/><path d="M12 14c0-3 2-5 5-5 0 3-2 5-5 5z"/></svg>`,
};

const CALCULADORAS = [
  { nombre: 'Agua', href: '/calculadoras/agua/', resuelve: 'Cuánta necesitas y cuánto te dura lo que ya tienes', icono: 'gota' },
  { nombre: 'Dosis de cloro', href: '/calculadoras/dosis-cloro/', resuelve: 'Gotas y mililitros exactos para desinfectar', icono: 'matraz' },
  { nombre: 'Reserva de comida', href: '/calculadoras/reserva-comida/', resuelve: 'Kilos por categoría según personas y días', icono: 'saco' },
  { nombre: 'Conversor', href: '/calculadoras/conversor/', resuelve: 'Peso, volumen y temperatura de cocina', icono: 'cambio' },
  { nombre: 'Inventario', href: '/inventario/', resuelve: 'Alertas de rotación antes de que caduque', icono: 'caja' },
  { nombre: 'Viabilidad de semillas', href: '/calculadoras/viabilidad-semillas/', resuelve: 'Cuándo probar la germinación', icono: 'brote' },
];
---

<Base
  titulo="Reserva Viva — Calculadoras de agua, comida y semillas"
  descripcion="Calcula cuánta agua almacenar, cuánto te dura tu reserva y cuándo rotar tus alimentos. Gratis, sin registro, con cifras de la EPA, el CDC y los estándares Sphere."
>
  <section class="hero">
    <div class="envoltura">
      <span class="rotulo">Preparación doméstica</span>
      <h1>Cuántos días te dura lo que ya tienes en casa.</h1>
      <p class="hero__frase">
        Calcula cuánta agua necesitas y cuánto te dura la que ya tienes, con
        las cifras que usan los organismos de emergencia, no estimaciones.
      </p>
    </div>
  </section>

  <section class="envoltura seccion-agua">
    {/* client:visible = el HTML se sirve estático y React solo se carga
        cuando la calculadora entra en pantalla. Ese es el modelo de islas. */}
    <CalculadoraAgua client:visible />

    <div class="aviso">
      <strong>Lo que estas cifras no cubren:</strong> el agua almacenada no sirve
      de nada si se contamina en el recipiente. Usa envases de grado alimenticio
      con boca angosta o grifo, y rota cada seis meses.
    </div>
  </section>

  <section class="envoltura rejilla-seccion" id="calculadoras">
    <h2>Calculadoras</h2>
    <p class="prosa">Seis herramientas, cada una con su fuente citada. Ninguna pide correo.</p>

    <div class="rejilla-calc">
      {CALCULADORAS.map((c) => (
        <a class="tarjeta-calc" href={c.href}>
          <span class="tarjeta-calc__icono" set:html={ICONOS[c.icono]} />
          <span class="tarjeta-calc__nombre">{c.nombre}</span>
          <span class="tarjeta-calc__resuelve">{c.resuelve}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="descarga-seccion" id="descarga">
    <div class="envoltura descarga">
      <span class="descarga__insignia">Descarga gratuita · sin correo, sin registro</span>
      <h2 class="descarga__titulo">Agua Segura en Emergencia</h2>
      <p class="descarga__subtitulo">
        Las 5 fichas que deberías tener pegadas en la despensa
      </p>

      <ul class="descarga__lista">
        <li>Cuánta agua necesitas según cuántos vivan en tu casa</li>
        <li>Cómo hervirla y cuánto esperar, con las dosis de cloro exactas</li>
        <li>Desinfección solar cuando no tienes ni fuego ni lejía</li>
        <li>Cómo guardarla sin que se contamine en el envase</li>
      </ul>

      <div class="descarga__pie">
        <p class="descarga__meta">8 páginas · ilustradas · listas para imprimir</p>
        <a class="descarga__boton" href="/Agua_Segura_en_Emergencia_GRATIS.pdf" download>
          Descargar PDF gratis
        </a>
      </div>
    </div>
  </section>

  <section class="envoltura confianza">
    <h2>Por qué confiar en estas cifras</h2>
    <div class="confianza__cuerpo">
      <ul class="confianza__fuentes">
        <li>EPA</li>
        <li>CDC</li>
        <li>Sphere</li>
        <li>USDA</li>
      </ul>
      <p class="prosa">
        Cada calculadora cita de dónde sale cada cifra que usa, no
        estimaciones a ojo. Y todo el sitio —calculadoras, inventario y la
        guía descargable— es gratis y no pide registro ni correo.
      </p>
    </div>
  </section>

  <style>
    .hero {
      padding-top: var(--espacio-m);
      padding-bottom: var(--espacio-s);
    }
    .hero h1 {
      font-size: clamp(2.1rem, 1.3rem + 4vw, 3.4rem);
      max-width: 20ch;
      margin-bottom: 0.5rem;
    }
    .hero__frase {
      max-width: var(--ancho-texto);
      font-size: 1.1rem;
      color: var(--apagado);
      margin: 0;
    }
    .seccion-agua {
      padding-top: var(--espacio-s);
      padding-bottom: var(--espacio-m);
    }

    .descarga-seccion {
      background: var(--verde);
      padding-block: var(--espacio-l);
    }
    .descarga {
      color: var(--papel-alto);
    }
    .descarga__insignia {
      display: block;
      font-family: var(--dato);
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--verde-claro);
      margin-bottom: 0.9rem;
    }
    .descarga__titulo {
      font-family: var(--display);
      font-weight: 700;
      font-size: clamp(1.9rem, 1.4rem + 2.5vw, 2.8rem);
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: var(--papel-alto);
      margin: 0 0 0.4rem;
    }
    .descarga__subtitulo {
      font-size: 1.1rem;
      color: var(--papel-alto);
      opacity: 0.92;
      max-width: 34ch;
      margin: 0 0 1.5rem;
    }
    .descarga__lista {
      list-style: none;
      padding: 0;
      margin: 0 0 1.75rem;
      display: grid;
      gap: 0.6rem;
      max-width: 36rem;
    }
    .descarga__lista li {
      position: relative;
      padding-left: 1.4rem;
      font-size: 0.98rem;
      line-height: 1.5;
    }
    .descarga__lista li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.55em;
      width: 8px;
      height: 8px;
      border-radius: 1px;
      background: var(--verde-claro);
    }
    .descarga__pie {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1.25rem;
    }
    .descarga__meta {
      font-family: var(--dato);
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--verde-claro);
      margin: 0;
    }
    .descarga__boton {
      display: inline-block;
      background: var(--papel-alto);
      color: var(--verde);
      font-family: var(--display);
      font-weight: 700;
      font-size: 1rem;
      padding: 0.9rem 1.75rem;
      border-radius: var(--radio);
      text-decoration: none;
      white-space: nowrap;
    }
    .descarga__boton:hover { background: var(--papel); }
    @media (max-width: 30rem) {
      .descarga__pie { flex-direction: column; align-items: flex-start; }
      .descarga__boton { width: 100%; text-align: center; }
    }

    .rejilla-seccion {
      margin-top: var(--espacio-l);
    }
    .rejilla-calc {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
      margin-top: var(--espacio-s);
    }
    @media (max-width: 48rem) {
      .rejilla-calc { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 30rem) {
      .rejilla-calc { grid-template-columns: 1fr; }
    }
    .tarjeta-calc {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      padding: 1.5rem;
      border: 1px solid var(--linea);
      border-radius: var(--radio);
      background: var(--papel-alto);
      text-decoration: none;
      color: var(--tinta);
    }
    .tarjeta-calc:hover {
      border-color: var(--verde);
    }
    .tarjeta-calc__icono {
      color: var(--apagado);
    }
    .tarjeta-calc:hover .tarjeta-calc__icono {
      color: var(--verde);
    }
    .tarjeta-calc__icono :global(svg) {
      display: block;
      width: 28px;
      height: 28px;
    }
    .tarjeta-calc__nombre {
      font-family: var(--display);
      font-weight: 700;
      font-size: 1.05rem;
    }
    .tarjeta-calc__resuelve {
      font-size: 0.9rem;
      color: var(--apagado);
      line-height: 1.45;
    }

    .confianza {
      margin-top: var(--espacio-l);
      padding-top: var(--espacio-m);
      border-top: 1px solid var(--linea);
    }
    .confianza__cuerpo {
      display: grid;
      gap: 1.5rem;
      margin-top: var(--espacio-s);
    }
    @media (min-width: 48rem) {
      .confianza__cuerpo {
        grid-template-columns: auto 1fr;
        align-items: start;
        gap: 3rem;
      }
    }
    .confianza__fuentes {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
    }
    .confianza__fuentes li {
      font-family: var(--dato);
      font-size: 0.85rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--apagado);
      padding-bottom: 0.3rem;
      border-bottom: 2px solid var(--linea);
    }
  </style>
</Base>
