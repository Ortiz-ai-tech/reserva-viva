---
import Base from '../../layouts/Base.astro';
import ReservaComida from '../../components/ReservaComida.jsx';
---

<Base
  titulo="Cuánta comida almacenar por persona — calculadora por categoría"
  descripcion="Calcula los kilos de granos, legumbres, aceite y otras categorías que necesitas guardar según personas y días a cubrir."
>
  <section class="envoltura calc-pagina">
    <span class="rotulo">Calculadora · Comida</span>
    <h1>Cuánta comida almacenar por persona</h1>
    <p class="prosa entrada-texto">
      Indica cuántas personas y cuántos días quieres cubrir. La calculadora
      reparte una reserva anual de referencia en kilos por categoría —granos,
      legumbres, aceite, azúcar, leche en polvo y sal— prorrateada a tu caso.
    </p>
    <div class="regla"></div>

    <ReservaComida client:visible />
  </section>

  <style>
    .calc-pagina { padding-top: 2.5rem; padding-bottom: 3rem; }
    .calc-pagina h1 { max-width: 20ch; }
    .entrada-texto { color: var(--apagado); font-size: 1.05rem; }
  </style>
</Base>
