---
import Calculadora from '../../layouts/Calculadora.astro';
import Conversor from '../../components/Conversor.jsx';
---

<Calculadora
  titulo="Conversor de peso, volumen y temperatura para cocina"
  descripcion="Convierte gramos, libras, onzas, tazas, cucharadas, litros y grados Celsius, Fahrenheit y Kelvin, con las equivalencias de cocina más usadas."
  etiqueta="Calculadora · Cocina"
  h1="Conversor de peso, volumen y temperatura"
  contexto="Las equivalencias de cocina más usadas en un solo lugar: peso, volumen y temperatura, sin buscar la tabla cada vez."
  actual="conversor"
>
  <Conversor client:visible />

  <Fragment slot="explicacion">
    <p>
      Las equivalencias de peso y volumen son las del Sistema Internacional y
      el sistema US customary. Las de temperatura son la definición exacta de
      las escalas Celsius, Fahrenheit y Kelvin, no una aproximación.
    </p>
  </Fragment>
</Calculadora>
