---
import Base from '../../layouts/Base.astro';
import Conversor from '../../components/Conversor.jsx';
---

<Base
  titulo="Conversor de peso, volumen y temperatura para cocina"
  descripcion="Convierte gramos, libras, onzas, tazas, cucharadas, litros y grados Celsius, Fahrenheit y Kelvin, con las equivalencias de cocina más usadas."
>
  <section class="envoltura calc-pagina">
    <span class="rotulo">Calculadora · Cocina</span>
    <h1>Conversor de peso, volumen y temperatura</h1>
    <p class="prosa entrada-texto">
      Las equivalencias de cocina más usadas en un solo lugar: peso, volumen y
      temperatura, sin buscar la tabla cada vez.
    </p>
    <div class="regla"></div>

    <Conversor client:visible />
  </section>

  <style>
    .calc-pagina { padding-top: 2.5rem; padding-bottom: 3rem; }
    .calc-pagina h1 { max-width: 20ch; }
    .entrada-texto { color: var(--apagado); font-size: 1.05rem; }
  </style>
</Base>
