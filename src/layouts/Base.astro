---
import '../styles/global.css';

const {
  titulo,
  descripcion = 'Calculadoras gratuitas de agua, comida y semillas para preparación doméstica. Cifras de la EPA, el CDC y los estándares Sphere.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ruta = Astro.url.pathname;

const enlaces = [
  { href: '/#calculadoras', etiqueta: 'Calculadoras', activo: ruta === '/' || ruta.startsWith('/calculadoras') },
  { href: '/inventario/', etiqueta: 'Inventario', activo: ruta.startsWith('/inventario') },
  { href: '/#descarga', etiqueta: 'Guía gratis', activo: false },
  { href: '/guias/cuanta-agua-almacenar/', etiqueta: 'Guías', activo: ruta.startsWith('/guias') },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:wght@400;600&display=swap"
    />
  </head>

  <body>
    <header class="cabecera">
      <div class="envoltura cabecera__interior">
        <a href="/" class="marca">
          <span class="marca__nombre">Reserva Viva</span>
          <span class="marca__lema">Preparación con números reales</span>
        </a>

        <button
          type="button"
          class="menu-boton"
          id="menu-boton"
          aria-expanded="false"
          aria-controls="nav-principal"
          aria-label="Abrir menú"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <nav class="nav" id="nav-principal">
          {enlaces.map((enlace) => (
            <a
              href={enlace.href}
              class={enlace.activo ? 'activa' : ''}
              aria-current={enlace.activo ? 'page' : undefined}
            >
              {enlace.etiqueta}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pie">
      <div class="envoltura">
        <div class="regla"></div>
        <p class="fuente">
          Las calculadoras usan cifras de la EPA, el CDC, los estándares Sphere y el
          USDA. Este sitio informa sobre preparación doméstica y no sustituye
          asesoría médica ni de ingeniería. Para conservas caseras sigue
          literalmente la guía del USDA.
        </p>
        <p class="fuente">© {new Date().getFullYear()} Reserva Viva</p>
      </div>
    </footer>

    <script>
      const boton = document.getElementById('menu-boton');
      const nav = document.getElementById('nav-principal');

      boton?.addEventListener('click', () => {
        const abierta = nav?.getAttribute('data-abierta') === 'true';
        nav?.setAttribute('data-abierta', String(!abierta));
        boton.setAttribute('aria-expanded', String(!abierta));
        boton.setAttribute('aria-label', abierta ? 'Abrir menú' : 'Cerrar menú');
      });

      nav?.addEventListener('click', (e) => {
        if (e.target instanceof Element && e.target.tagName === 'A') {
          // Se cierra en el siguiente tick: si se hace sync, ocultar el <nav>
          // en pleno click puede cancelar la navegación del enlace en algunos
          // navegadores móviles.
          setTimeout(() => {
            nav.setAttribute('data-abierta', 'false');
            boton?.setAttribute('aria-expanded', 'false');
            boton?.setAttribute('aria-label', 'Abrir menú');
          }, 0);
        }
      });
    </script>

    <style>
      .cabecera {
        border-bottom: 1px solid var(--linea);
        background: var(--papel-alto);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .cabecera__interior {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 0.9rem;
        flex-wrap: wrap;
      }
      .marca {
        text-decoration: none;
        color: inherit;
        display: grid;
      }
      .marca__nombre {
        font-family: var(--display);
        font-weight: 700;
        font-size: 1.15rem;
        letter-spacing: -0.02em;
      }
      .marca__lema {
        font-family: var(--dato);
        font-size: 0.68rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--apagado);
      }
      .menu-boton {
        display: none;
        border: 1px solid var(--linea);
        background: var(--papel);
        color: var(--tinta);
        border-radius: var(--radio);
        padding: 0.4rem;
        cursor: pointer;
        align-items: center;
        justify-content: center;
      }
      .nav {
        display: flex;
        gap: 1.25rem;
        font-size: 0.94rem;
      }
      .nav a {
        color: var(--tinta);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        padding-bottom: 2px;
      }
      .nav a:hover {
        border-bottom-color: var(--verde);
      }
      .nav a.activa {
        color: var(--verde);
        border-bottom-color: var(--verde);
      }
      .pie {
        margin-top: var(--espacio-l);
        padding-bottom: 3rem;
      }
      .pie p {
        max-width: var(--ancho-texto);
      }

      @media (max-width: 42rem) {
        .menu-boton {
          display: inline-flex;
        }
        .nav {
          display: none;
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          width: 100%;
          order: 3;
          border-top: 1px solid var(--linea);
          margin-top: 0.9rem;
          padding-top: 0.25rem;
        }
        .nav[data-abierta='true'] {
          display: flex;
        }
        .nav a {
          padding: 0.9rem 0.25rem;
          border-bottom: 1px solid var(--linea);
        }
      }
    </style>
  </body>
</html>
